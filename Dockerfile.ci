FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /cxi-dra-driver ./cmd/cxi-dra-driver
RUN CGO_ENABLED=0 GOOS=linux go build -o /slingshot-cni ./cmd/slingshot-cni

FROM alpine:3.21
COPY --from=builder /cxi-dra-driver /cxi-dra-driver
COPY --from=builder /slingshot-cni /slingshot-cni
ENTRYPOINT ["/cxi-dra-driver"]
