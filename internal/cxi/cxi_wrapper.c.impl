/* cxi_wrapper.c — libcxi service management wrappers.
 *
 * Compilation requires:
 *   -I/opt/libcxi-netns/include
 *   -L/opt/libcxi-netns/lib -lcxi
 *
 * The caps-tum patch (HPE internal) is the reference for the ioctl sequences
 * used here. Key data structures:
 *
 *   cxil_dev           – opaque device handle from cxil_open_device()
 *   cxi_svc_desc       – service descriptor (resource limits, VNI, members)
 *   cxi_svc_member     – member entry (type CXI_SVC_MEMBER_NETNS + inode)
 *   cxil_alloc_svc()   – allocates (creates) the service
 *   cxil_destroy_svc() – destroys the service by svc_id
 *   cxil_get_svc_list()– enumerates all services on the device
 */

#include "cxi_wrapper.h"

#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <libcxi/libcxi.h>

/* --------------------------------------------------------------------------
 * Helpers
 * -------------------------------------------------------------------------- */

/* device_index parses the trailing integer from a name like "cxi0" -> 0. */
static int device_index(const char *name)
{
    int idx = 0;
    const char *p = name;
    while (*p && (*p < '0' || *p > '9'))
        p++;
    if (!*p)
        return -1;
    while (*p >= '0' && *p <= '9')
        idx = idx * 10 + (*p++ - '0');
    return idx;
}

/* --------------------------------------------------------------------------
 * cxi_create_service
 * -------------------------------------------------------------------------- */

int cxi_create_service(const char *device, uint64_t netns_inode, int vni)
{
    struct cxil_dev *dev = NULL;
    int dev_idx = device_index(device);
    if (dev_idx < 0)
        return -EINVAL;

    int rc = cxil_open_device(dev_idx, &dev);
    if (rc != 0) {
        fprintf(stderr, "cxi_wrapper: cxil_open_device(%d) failed: %d\n", dev_idx, rc);
        return rc;
    }

    /* Build a minimal service descriptor:
     *   - resource_limits = 1  (enforce limits below)
     *   - restricted_members = 1  (only our netns may attach)
     *   - one VNI
     *   - one member of type netns identified by inode
     *
     * Resource limits below are the "one service" defaults from DefaultResourceSet().
     * TODO: accept ResourceSet from Go side once explicit claim requests land.
     */
    struct cxi_svc_desc desc = {0};
    desc.resource_limits   = 1;
    desc.restricted_members = 1;
    desc.restricted_tcs    = 0;
    desc.exclusive_cp      = 0;

    /* Limits — mirrors DefaultResourceSet() in resources.go */
    desc.limits.txqs.res = 2;   desc.limits.txqs.max = 1024;
    desc.limits.tgqs.res = 1;   desc.limits.tgqs.max = 512;
    desc.limits.eqs.res  = 2;   desc.limits.eqs.max  = 2047;
    desc.limits.cts.res  = 1;   desc.limits.cts.max  = 2047;
    desc.limits.tles.res = 1;   desc.limits.tles.max = 2048;
    desc.limits.ptes.res = 6;   desc.limits.ptes.max = 2048;
    desc.limits.les.res  = 1;   desc.limits.les.max  = 16384;
    desc.limits.acs.res  = 4;   desc.limits.acs.max  = 1022;

    /* VNI */
    desc.num_vld_vnis      = 1;
    desc.vnis[0]           = (uint16_t)vni;

    /* Netns member */
    struct cxi_svc_member member = {0};
    member.type    = CXI_SVC_MEMBER_NETNS;
    member.svc_member.netns = netns_inode;

    unsigned int svc_id = 0;
    rc = cxil_alloc_svc(dev, &desc, &member, 1, &svc_id);
    if (rc != 0)
        fprintf(stderr, "cxi_wrapper: cxil_alloc_svc failed: %d\n", rc);
    else
        fprintf(stderr, "cxi_wrapper: created service id=%u on %s inode=%llu vni=%d\n",
                svc_id, device, (unsigned long long)netns_inode, vni);

    cxil_close_device(dev);
    return rc;
}

/* --------------------------------------------------------------------------
 * cxi_delete_service
 * -------------------------------------------------------------------------- */

int cxi_delete_service(const char *device, uint64_t netns_inode)
{
    struct cxil_dev *dev = NULL;
    int dev_idx = device_index(device);
    if (dev_idx < 0)
        return -EINVAL;

    int rc = cxil_open_device(dev_idx, &dev);
    if (rc != 0) {
        fprintf(stderr, "cxi_wrapper: cxil_open_device(%d) failed: %d\n", dev_idx, rc);
        return rc;
    }

    /* Enumerate all services and find the one with our netns inode. */
    struct cxil_svc_list *list = NULL;
    rc = cxil_get_svc_list(dev, &list);
    if (rc != 0) {
        fprintf(stderr, "cxi_wrapper: cxil_get_svc_list failed: %d\n", rc);
        cxil_close_device(dev);
        return rc;
    }

    unsigned int target_id = 0;
    for (unsigned int i = 0; i < list->count; i++) {
        const struct cxil_svc_entry *e = &list->entries[i];
        for (unsigned int m = 0; m < e->num_members; m++) {
            if (e->members[m].type == CXI_SVC_MEMBER_NETNS &&
                e->members[m].svc_member.netns == netns_inode) {
                target_id = e->svc_id;
                break;
            }
        }
        if (target_id)
            break;
    }
    cxil_free_svc_list(list);

    if (!target_id) {
        fprintf(stderr, "cxi_wrapper: no service found for inode=%llu on %s\n",
                (unsigned long long)netns_inode, device);
        cxil_close_device(dev);
        return -ENOENT;
    }

    rc = cxil_destroy_svc(dev, target_id);
    if (rc != 0)
        fprintf(stderr, "cxi_wrapper: cxil_destroy_svc(%u) failed: %d\n", target_id, rc);
    else
        fprintf(stderr, "cxi_wrapper: destroyed service id=%u on %s\n", target_id, device);

    cxil_close_device(dev);
    return rc;
}
