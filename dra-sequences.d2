
# ── SEQUENCE 1: Node Boot ──────────────────────────────────────────────────────

node_boot: {
  shape: sequence_diagram
  title: "Node Boot — Driver Startup"

  os
  main
  cxi_pkg
  driver
  nri
  binder
  vni_allocator
  kubelet
  apiserver

  os -> main: "DaemonSet pod scheduled\n(NODE_NAME, POD_UID, POD_NAMESPACE injected as env)"

  main -> cxi_pkg: "Discover() [mock or sysfs]"
  cxi_pkg -> cxi_pkg: "walk /sys/class/cxi_user/*\nread NUMANode, PCIBusID per device"
  cxi_pkg -> cxi_pkg: "DiscoverHSN(): match HSN iface by PCIe root"
  cxi_pkg -> cxi_pkg: "publish standard attrs:\nresource.kubernetes.io/{numaNode, pciBusID}"
  cxi_pkg -> cxi_pkg: "read hardware totals + blessed system-service reservation\n(-tags cxi: libcxi ioctls)"
  cxi_pkg -> main: "[]Device{cxi0(hsn2), cxi1(hsn0), ...}"

  main -> driver: "driver.New(Config{devices, kubeClient, overhead, ...})"
  main -> driver: "driver.Run(ctx) → discovers + writes CDI"
  driver -> driver: "cdi.WriteSpec per device\n(/var/run/cdi/cxi-cxiN.json)"

  main -> nri: "nri.NewPlugin(store, svcMgr, driver)"
  main -> nri: "go plugin.Run(ctx)"
  nri -> kubelet: "NRI socket handshake (/var/run/nri/nri.sock)"
  kubelet -> nri: "RegisterPlugin ACK\n(subscribes RunPodSandbox, StopPodSandbox)"

  driver -> kubelet: "kubeletplugin.Start (DRA gRPC)\n(plugin socket + registrar)"
  kubelet -> driver: "ACK"
  driver -> apiserver: "PublishResources (ResourceSlice CXI, once)\ncxi0..3: allowMultipleAllocations,\ncapacity txqs…tles = usable ceiling"

  main -> binder: "NewClaimBinder(driver, kubeClient)"
  main -> binder: "go binder.Run(ctx) → watch ResourceClaims"

  main -> vni_allocator: "StartNamespaceVNIAllocator(KubeClient, Namespace, Identity, VNIStart, VNIEnd)"
  vni_allocator -> apiserver: "leader-election Lease (<driverName>-vni-allocator-leader)"
  apiserver -> vni_allocator: "lease acquired / waiting"
  vni_allocator -> apiserver: "(leader) informer watches Namespaces\nqueue.Add for each, patch with VNI"

  driver -> driver: "loop: reaper ticker\n→ reapOrphanServices"
}

# ── SEQUENCE 2: Namespace Creation → VNI Assignment ──────────────────────────

namespace_vni: {
  shape: sequence_diagram
  title: "Namespace Creation — VNI Allocator Assigns Annotation"

  user
  apiserver
  informer
  leader_allocator
  follower_allocator

  user -> apiserver: "kubectl create namespace alice"
  apiserver -> informer: "Namespace ADDED event"
  informer -> leader_allocator: "queue.Add(\"alice\")"

  leader_allocator -> leader_allocator: "reconcile(\"alice\")\n- skip if in skip-list? NO\n- get namespace\n- annotation already set? NO"
  leader_allocator -> apiserver: "List namespaces → assignedVNIs"
  apiserver -> leader_allocator: "{1: true, 2: true, 5: true, ...}"
  leader_allocator -> leader_allocator: "nextFreeVNI([1..N]) → 3"
  leader_allocator -> apiserver: "MergePatch namespace/alice\n  metadata.annotations[cxi.slingshot.hpe.com/vni] = \"3\""
  apiserver -> leader_allocator: "Patch OK"
  leader_allocator -> leader_allocator: "queue.Forget(\"alice\")"

  apiserver -> follower_allocator: "(no-op: not the leader)"
}

# ── SEQUENCE 3: Pod Scheduling through Container Start ───────────────────────

pod_lifecycle: {
  shape: sequence_diagram
  title: "Pod Lifecycle — Scheduling, Binding, Service Creation, Container Start"

  user
  apiserver
  admission
  scheduler
  binder
  prepare
  store
  kubelet
  containerd
  nri
  cxi_svc

  user -> apiserver: "kubectl apply -f pod.yaml\n(refs ResourceClaimTemplate cxi-small)"

  apiserver -> admission: "ResourceClaim CREATE intercepted"
  admission -> admission: "legacy claim (opaque config, no capacity)?\n  add exactly.capacity.requests\n  (le_pools×1024 → les, tle_pools×512 → tles)\nnative capacity.requests → untouched"
  admission -> apiserver: "ResourceClaim persisted"

  apiserver -> scheduler: "Pod pending\n(resourceClaims: [cxi-template])"
  scheduler -> apiserver: "GET ResourceSlices(driver=cxi.slingshot.hpe.com)"
  apiserver -> scheduler: "ResourceSlice CXI: cxi0..3 per node\n(capacity txqs…tles + requestPolicy)"
  scheduler -> scheduler: "round request up by requestPolicy\n(les → ×1024, tles → ×512; defaults for unrequested)\nΣ consumedCapacity on device + request ≤ capacity?\n→ pick node=worker-1, device=cxi0"
  scheduler -> apiserver: "patch claim.status.allocation\n+ consumedCapacity + shareID\n+ bindingConditions=[Ready]"

  apiserver -> binder: "watch event: claim allocated to worker-1/cxi0"
  binder -> binder: "requested = allocation consumedCapacity"
  binder -> binder: "hwAvail = ReadAvailableCapacity(cxi0)"
  binder -> binder: "checkAndAddPending(claimUID, cxi0, requested, hwAvail) under pendingMu:\n  - requested ≤ hwAvail − pending? → granted=true\n  - else → false (hardware full)"

  # — Happy path: capacity fits (same-namespace co-location permitted)
  binder -> binder: "granted=true →\n  pending[(uid,cxi0)] = {cxi0, resources}"
  binder -> apiserver: "patch claim: BindingCondition Ready=True"

  # — Alternate: hardware truly full (only with consumption the scheduler cannot see)
  binder -> binder: "(hardware full: out-of-band services /\npre-upgrade claims) Unschedulable=True\nreason=DeviceAtCapacity"
  binder -> apiserver: "patch claim: Unschedulable=True (DeviceAtCapacity)"
  binder -> scheduler: "scheduler deallocates + retries"

  # — Scheduler-side cleanup: Allocation cleared (PostFilter / Unschedulable / manual edit)
  scheduler -> apiserver: "patch claim.status.allocation = nil"
  apiserver -> binder: "watch event: claim.status.allocation = nil"
  binder -> binder: "evaluateClaim(Allocation=nil):\n  RemovePending(uid)"

  # Pod binds, kubelet calls prepare
  scheduler -> apiserver: "bind pod to worker-1"
  apiserver -> kubelet: "pod assigned"
  kubelet -> prepare: "NodePrepareResources(claims)"

  prepare -> prepare: "for each device allocated to this driver:\n  ResourceSet from consumedCapacity\n  (opaque config fallback; reject if opaque > consumed)\n  fast-fail if request > usableCeiling"
  prepare -> apiserver: "Get namespace/<podNs>\nread annotation cxi.slingshot.hpe.com/vni"
  apiserver -> prepare: "vni = 3"
  prepare -> store: "Set(podUID, [{Device:cxi0, HSN:hsn2, VNI:3, Resources}])"
  prepare -> kubelet: "return CDI device IDs:\n  cxi.slingshot.hpe.com/cxi0"

  kubelet -> containerd: "RunPodSandbox (apply CDI for cxi0)"
  containerd -> containerd: "bind /dev/cxi0 (CDI DeviceNodes)\nno privileged required"

  containerd -> nri: "NRI hook: RunPodSandbox(podUID, netns)"
  nri -> nri: "per-device mutex on cxi0\nstat netns → inode=98765"
  nri -> store: "Get(podUID) → {cxi0, hsn2, VNI=3, ResourceSet}"
  nri -> nri: "secondary fit-check (defensive)"
  nri -> cxi_svc: "CreateService(cxi0, netnsInode=98765, vni=3, ResourceSet)"
  cxi_svc -> cxi_svc: "open /dev/cxi0\nlibcxi ioctl: alloc service\nscoped to (netns inode, VNI)"
  cxi_svc -> nri: "serviceID=7"
  nri -> nri: "buildNetSysfs: build synthetic /sys/class/net\n  (host path; HSN BDF + speed read from host /sys/class/net/hsn2)"
  nri -> nri: "podStates[podUID] = {cxi0: svcID=7, netSysfsDir}"
  nri -> binder: "(via driver) RemovePending(uid)\n  → grant now reflected in live hardware capacity"

  containerd -> nri: "NRI hook: CreateContainer(podUID, container)"
  nri -> nri: "AddEnv SLINGSHOT_DEVICES=cxi0,\n  SLINGSHOT_VNIS=3, SLINGSHOT_SVC_IDS=7"
  nri -> nri: "overmount /sys/class/net ← synthetic tree\n  (stock libfabric sees hsn2: operstate=up)"
  nri -> containerd: "ContainerAdjustment"

  containerd -> containerd: "start container process\n(libfabric sees /dev/cxi0, opens it,\n  uses service for fabric ops)"

  # Teardown via NRI (normal path)
  containerd -> nri: "NRI hook: StopPodSandbox"
  nri -> cxi_svc: "DestroyService(cxi0, svcID=7)"
  nri -> nri: "RemoveAll netns sysfs tree (<root>/<podUID>)"
  nri -> binder: "TriggerRetry (unblock Ready=False waiters)"

  kubelet -> prepare: "NodeUnprepareResources(claims)"
  prepare -> store: "Delete(podUID)\n  → AllocationStore only; does NOT touch pending"

  # Claim cleanup (binder catches scheduler-side / force-delete)
  apiserver -> binder: "watch event: ResourceClaim DELETED"
  binder -> binder: "onClaimDeleted:\n  RemovePending(uid)\n    → idempotent no-op if NRI already released"
}

# ── SEQUENCE 4: Orphan-service Reaper (drift backstop) ───────────────────────

reap_orphans: {
  shape: sequence_diagram
  title: "Orphan-service Reaper — Service Recovery (driver restart, force-delete, NRI short-circuit)"

  driver
  reaper
  cxi_pkg
  nri
  svcmgr

  driver -> reaper: "ticker fires (--resource-refresh-interval)"
  reaper -> reaper: "skip if mockDevices != nil (test build)"

  reaper -> nri: "LiveSvcIDs() → svc_ids the NRI plugin still owns\n  for live pods, grouped by device"
  nri -> reaper: "map[dev][]svcID"

  reaper -> cxi_pkg: "for each advertised device:\n  ReadActiveServices(cxiN)"
  cxi_pkg -> cxi_pkg: "cxil_get_svc_list(dev) →\n  for each svc: {svc_id, vni, is_system_svc}"
  cxi_pkg -> reaper: "[]ServiceInfo per device (incl. system + VNI-less)"

  reaper -> reaper: "for each service, PRESERVE if ANY:\n  - svc_id blessed (--system-svc-ids)\n  - is_system_svc bit set\n  - owned by a live pod (LiveSvcIDs)\n  - recorded netns still live on node\n  - netns indeterminate (read error / 0)"
  reaper -> cxi_pkg: "ReadServiceNetns(dev, svcID) for candidates"
  cxi_pkg -> reaper: "netns inode (low 32 bits) or error"

  reaper -> reaper: "candidate orphaned N consecutive cycles?\n  (grace period — avoids racing a just-created service)"
  reaper -> svcmgr: "DeleteService(dev, svcID) for confirmed orphans"
  svcmgr -> cxi_pkg: "cxil_destroy_svc(dev, svcID)"
}
