
# ── SEQUENCE 1: Node Boot ──────────────────────────────────────────────────────

node_boot: {
  shape: sequence_diagram
  title: "Node Boot — Driver Startup"

  os
  main
  cxi_pkg
  driver
  nri
  binder
  vni_allocator
  kubelet
  apiserver

  os -> main: "DaemonSet pod scheduled\n(NODE_NAME, POD_UID, POD_NAMESPACE injected as env)"

  main -> cxi_pkg: "Discover() [mock or sysfs]"
  cxi_pkg -> cxi_pkg: "walk /sys/class/cxi_user/*\nread NUMANode, PCIeRoot per device"
  cxi_pkg -> cxi_pkg: "DiscoverHSN(): match HSN iface by PCIe root"
  cxi_pkg -> cxi_pkg: "GPU co-location: find NUMA-local NVIDIA GPU\n→ republish its PCIe root as resource.kubernetes.io/pcieRoot"
  cxi_pkg -> cxi_pkg: "ReadAvailableCapacity (-tags cxi: libcxi ioctls)"
  cxi_pkg -> main: "[]Device{cxi0(hsn2), cxi1(hsn0), ...}"

  main -> driver: "driver.New(Config{devices, kubeClient, overhead, ...})"
  main -> driver: "driver.Run(ctx) → discovers + writes CDI"
  driver -> driver: "cdi.WriteSpec per device\n(/var/run/cdi/cxi-cxiN.json)"

  main -> nri: "nri.NewPlugin(store, svcMgr, driver)"
  main -> nri: "go plugin.Run(ctx)"
  nri -> kubelet: "NRI socket handshake (/var/run/nri/nri.sock)"
  kubelet -> nri: "RegisterPlugin ACK\n(subscribes RunPodSandbox, StopPodSandbox)"

  driver -> kubelet: "kubeletplugin.Start (DRA gRPC)\n(plugin socket + registrar)"
  kubelet -> driver: "ACK"
  driver -> apiserver: "PublishResources (ResourceSlice CXI)\ncxi0..3 with capacity + initial avail_* + active_namespaces=\"\""

  main -> binder: "NewClaimBinder(driver, kubeClient)"
  main -> binder: "go binder.Run(ctx) → watch ResourceClaims"

  main -> vni_allocator: "StartNamespaceVNIAllocator(KubeClient, Namespace, Identity, VNIStart, VNIEnd)"
  vni_allocator -> apiserver: "leader-election Lease (cxi-vni-allocator-leader)"
  apiserver -> vni_allocator: "lease acquired / waiting"
  vni_allocator -> apiserver: "(leader) informer watches Namespaces\nqueue.Add for each, patch with VNI"

  driver -> driver: "loop: refresh ticker + d.notify\n→ reconcileOccupancyFromHardware\n→ PublishResources (refresh avail_* + active_namespaces)"
}

# ── SEQUENCE 2: Namespace Creation → VNI Assignment ──────────────────────────

namespace_vni: {
  shape: sequence_diagram
  title: "Namespace Creation — VNI Allocator Assigns Annotation"

  user
  apiserver
  informer
  leader_allocator
  follower_allocator

  user -> apiserver: "kubectl create namespace alice"
  apiserver -> informer: "Namespace ADDED event"
  informer -> leader_allocator: "queue.Add(\"alice\")"

  leader_allocator -> leader_allocator: "reconcile(\"alice\")\n- skip if in skip-list? NO\n- get namespace\n- annotation already set? NO"
  leader_allocator -> apiserver: "List namespaces → assignedVNIs"
  apiserver -> leader_allocator: "{1: true, 2: true, 5: true, ...}"
  leader_allocator -> leader_allocator: "nextFreeVNI([1..N]) → 3"
  leader_allocator -> apiserver: "MergePatch namespace/alice\n  metadata.annotations[cxi.slingshot.hpe.com/vni] = \"3\""
  apiserver -> leader_allocator: "Patch OK"
  leader_allocator -> leader_allocator: "queue.Forget(\"alice\")"

  apiserver -> follower_allocator: "(no-op: not the leader)"
}

# ── SEQUENCE 3: Pod Scheduling through Container Start ───────────────────────

pod_lifecycle: {
  shape: sequence_diagram
  title: "Pod Lifecycle — Scheduling, Binding, Service Creation, Container Start"

  user
  apiserver
  admission
  scheduler
  binder
  prepare
  store
  kubelet
  containerd
  nri
  cxi_svc

  user -> apiserver: "kubectl apply -f pod.yaml\n(refs ResourceClaimTemplate cxi-small)"

  apiserver -> admission: "ResourceClaim CREATE intercepted"
  admission -> admission: "CEL: inject opaque CXI config\n(all 8 fields present? injected if not)"
  admission -> admission: "CEL: inject 2 selectors:\n  (1) avail_* >= request (capacity headroom)\n  (2) !active_namespaces.contains(\",<NS>,\")\n      (per-ns device exclusion; <NS> interpolated literal)"
  admission -> apiserver: "patched ResourceClaim persisted"

  apiserver -> scheduler: "Pod pending\n(resourceClaims: [cxi-template])"
  scheduler -> apiserver: "GET ResourceSlices(driver=cxi.slingshot.hpe.com)"
  apiserver -> scheduler: "ResourceSlice CXI: cxi0..3 per node\n(avail_txqs, avail_les, ..., active_namespaces)"
  scheduler -> scheduler: "filter via BOTH CEL selectors\nscore filtered devices\n→ pick node=worker-1, device=cxi0"
  scheduler -> apiserver: "patch claim.status.allocation\n+ allocation.bindingConditions=[Ready]"

  apiserver -> binder: "watch event: claim allocated to worker-1/cxi0"
  binder -> binder: "resolve requested ResourceSet from claim config"
  binder -> binder: "hwAvail = ReadAvailableCapacity(cxi0)"
  binder -> binder: "checkAndAddPending(claimUID, ns, cxi0, requested, hwAvail) under pendingMu:\n  - nsDeviceOccupancy[ns][cxi0] held by another UID? → occupied=true\n    (SHS14 -EEXIST guard; rare with CEL pre-filter)\n  - else: requested ≤ hwAvail − pending? → granted=true\n  - else → both false (hardware full)"

  # — Happy path: capacity fits AND ns not yet on this device
  binder -> binder: "granted=true →\n  pending[uid] = {ns, cxi0, resources}\n  nsDeviceOccupancy[ns][cxi0] = uid\n  claimToOccupancy[uid] = {ns, cxi0}"
  binder -> apiserver: "patch claim: BindingCondition Ready=True"
  binder -> binder: "TriggerRepublish (notify chan)"
  binder -> apiserver: "ResourceSlice republish (avail_* reduced; active_namespaces gains <NS>)"

  # — Alternate A: hardware truly full
  binder -> binder: "(hardware full) Unschedulable=True\nreason=DeviceAtCapacity"
  binder -> apiserver: "patch claim: Unschedulable=True (DeviceAtCapacity)"
  binder -> scheduler: "scheduler deallocates + retries"

  # — Alternate B: namespace already on this device (SHS14 guard)
  binder -> binder: "(occupied) Unschedulable=True\nreason=NamespaceDeviceOccupied"
  binder -> apiserver: "patch claim: Unschedulable=True (NamespaceDeviceOccupied)"
  binder -> scheduler: "scheduler deallocates + retries on different device"

  # — Scheduler-side cleanup: Allocation cleared (PostFilter / Unschedulable / manual edit)
  scheduler -> apiserver: "patch claim.status.allocation = nil"
  apiserver -> binder: "watch event: claim.status.allocation = nil"
  binder -> binder: "evaluateClaim(Allocation=nil):\n  RemovePending(uid)\n  RemoveOccupancyForClaim(uid)\n    → removeOccupancyLocked: clears nsDeviceOccupancy[ns][cxi0]\n      and claimToOccupancy[uid]"
  binder -> binder: "TriggerRepublish (other claims in <NS> can now target cxi0)"

  # Pod binds, kubelet calls prepare
  scheduler -> apiserver: "bind pod to worker-1"
  apiserver -> kubelet: "pod assigned"
  kubelet -> prepare: "NodePrepareResources(claims)"

  prepare -> prepare: "for each device allocated to this driver:\n  resolve ResourceSet from opaque config\n  fast-fail if request > usableCeiling"
  prepare -> apiserver: "Get namespace/<podNs>\nread annotation cxi.slingshot.hpe.com/vni"
  apiserver -> prepare: "vni = 3"
  prepare -> store: "Set(podUID, [{Device:cxi0, HSN:hsn2, VNI:3, Resources}])"
  prepare -> kubelet: "return CDI device IDs:\n  cxi.slingshot.hpe.com/cxi0"

  kubelet -> containerd: "RunPodSandbox (apply CDI for cxi0)"
  containerd -> containerd: "bind /dev/cxi0 (CDI DeviceNodes)\nno privileged required"

  containerd -> nri: "NRI hook: RunPodSandbox(podUID, netns)"
  nri -> nri: "per-device mutex on cxi0\nstat netns → inode=98765"
  nri -> store: "Get(podUID) → {cxi0, hsn2, VNI=3, ResourceSet}"
  nri -> nri: "secondary fit-check (defensive)"
  nri -> cxi_svc: "CreateService(cxi0, netnsInode=98765, vni=3, ResourceSet)"
  cxi_svc -> cxi_svc: "open /dev/cxi0\nlibcxi ioctl: alloc service\nscoped to (netns inode, VNI)"
  cxi_svc -> nri: "serviceID=7"
  nri -> nri: "buildNetSysfs: build synthetic /sys/class/net\n  (host path; HSN BDF + speed read from host /sys/class/net/hsn2)"
  nri -> nri: "podStates[podUID] = {cxi0: svcID=7, netSysfsDir}"
  nri -> binder: "(via driver) RemovePending(uid)\n  → NOTE: does NOT touch nsDeviceOccupancy"

  containerd -> nri: "NRI hook: CreateContainer(podUID, container)"
  nri -> nri: "AddEnv SLINGSHOT_DEVICES=cxi0,\n  SLINGSHOT_VNIS=3, SLINGSHOT_SVC_IDS=7"
  nri -> nri: "overmount /sys/class/net ← synthetic tree\n  (stock libfabric sees hsn2: operstate=up)"
  nri -> containerd: "ContainerAdjustment"

  containerd -> containerd: "start container process\n(libfabric sees /dev/cxi0, opens it,\n  uses service for fabric ops)"

  # Teardown via NRI (normal path)
  containerd -> nri: "NRI hook: StopPodSandbox"
  nri -> cxi_svc: "DestroyService(cxi0, svcID=7)"
  nri -> nri: "RemoveAll netns sysfs tree (<root>/<podUID>)"
  nri -> binder: "(via driver) RemoveOccupancy(ns, cxi0)\n  → removeOccupancyLocked: clears slot + reverse index\n  → unblocks future claims from same ns on cxi0"
  nri -> binder: "TriggerRetry (unblock Ready=False waiters)"
  nri -> binder: "TriggerRepublish (active_namespaces loses <NS>)"

  kubelet -> prepare: "NodeUnprepareResources(claims)"
  prepare -> store: "Delete(podUID)\n  → AllocationStore only; does NOT touch occupancy"

  # Claim cleanup (binder catches scheduler-side / force-delete)
  apiserver -> binder: "watch event: ResourceClaim DELETED"
  binder -> binder: "onClaimDeleted:\n  RemovePending(uid)\n  RemoveOccupancyForClaim(uid)\n    → idempotent no-op if NRI already released"
}

# ── SEQUENCE 4: Polling Reconciler (drift backstop) ──────────────────────────

reconcile_drift: {
  shape: sequence_diagram
  title: "Polling Reconciler — Drift Recovery (driver restart, missed events, force-delete)"

  driver
  reconciler
  cxi_pkg
  apiserver
  pending_state

  driver -> reconciler: "ticker fires (--resource-refresh-interval)"
  reconciler -> reconciler: "skip if mockDevices != nil (test build)"

  reconciler -> apiserver: "Namespaces().List() [paged]"
  apiserver -> reconciler: "[{name: alice, annotations[cxi.../vni]: 3},\n {name: bob,   annotations[cxi.../vni]: 7}, ...]"
  reconciler -> reconciler: "build vniToNS map; filter invalid (missing/0/out-of-range)"

  reconciler -> cxi_pkg: "for each advertised device:\n  ReadActiveServiceVNIs(cxiN)"
  cxi_pkg -> cxi_pkg: "cxil_get_svc_list(dev) →\n  for each svc: cxil_svc_get_vni_range\n  → vmin (== vmax under SHS14 single-VNI services)\n  skip vmin == 0 (system / non-DRA services)"
  cxi_pkg -> reconciler: "[]uint16 per device: live VNIs"

  reconciler -> reconciler: "build hwSet: {(ns, dev): {} }\n  by joining vniToNS × per-device VNI list"

  reconciler -> pending_state: "applyReconcile(hwSet) under pendingMu:"
  pending_state -> pending_state: "for each (ns,dev) in nsDeviceOccupancy with UID u:\n  KEEP if u in pending OR (ns,dev) in hwSet\n  else removeOccupancyLocked(ns, dev)\n        + log 'released leaked occupancy slot'"
  pending_state -> pending_state: "for each (ns,dev) in hwSet NOT yet in nsDeviceOccupancy:\n  syntheticUID = 'hw:' + dev + '/' + ns\n  nsDeviceOccupancy[ns][dev] = syntheticUID\n  claimToOccupancy[syntheticUID] = {ns, dev}\n  + log 'discovered hardware occupancy (synthetic uid)'"
  pending_state -> reconciler: "changed = true|false"

  reconciler -> driver: "TriggerRepublish if changed\n  (coalesced with the upcoming publish())"
  driver -> driver: "publish() — same tick reflects the reconciler's state changes"

  # Self-cleaning case: synthetic entry released after hardware service goes away
  reconciler -> reconciler: "(next tick after service teardown)"
  reconciler -> cxi_pkg: "ReadActiveServiceVNIs(cxiN)"
  cxi_pkg -> reconciler: "(VNI absent — service was destroyed)"
  reconciler -> pending_state: "applyReconcile(hwSet without (ns,dev)):\n  synthetic UID not in pending AND (ns,dev) not in hwSet\n  → removeOccupancyLocked → slot released, reverse index cleared"
}
