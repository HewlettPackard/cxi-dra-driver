direction: down

# Legend
legend: {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#9e9e9e"
  label: "■ Implemented  □ Not yet implemented  ◈ External (k8s/user)"
}

# ── USER / WORKLOAD (external) ─────────────────────────────────────────────────

Workload: {
  direction: down
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  label: "◈ Workload (user-created)"

  Owning Resource: {
    shape: sql_table
    kind: "Deployment / ReplicaSet / StatefulSet / Job"
  }

  Device Claim Template: {
    shape: sql_table
    type: "ResourceClaimTemplate"
    deviceClassName: "cxi-device"
    shape_examples: "cxi-small / cxi-medium / cxi-large / cxi-whole"
    per_pod: "ephemeral claim per pod (one CXI, no VNI claim)"
  }

  Pods: {
    direction: right
    style.fill: "#bdbdbd"
    POD: {
      shape: sql_table
      status: "pending → bound → running"
      resourceClaims: "single CXI device template"
    }
  }

  Owning Resource -> Pods.POD: "creates (many)"
  Owning Resource -> Device Claim Template: "references"
}

# ── MUTATING ADMISSION POLICY (implemented; declarative CEL) ───────────────────

Admission: {
  direction: down
  style.fill: "#fff3e0"
  label: "■ MutatingAdmissionPolicy (CEL)"

  Policy: {
    shape: sql_table
    label: "■ admission-policy.yaml"
    role: "auto-injects opaque CXI defaults + two CEL selectors"
    triggers_on: "ResourceClaim CREATE"
    failure_policy: "Ignore (claim passes through)"
    constants: "TLEPoolSize=512, LEPoolSize=1024"
    selector_1: "avail_* >= request (per-resource capacity steering)"
    selector_2: "!active_namespaces.contains(\",<NS>,\") (per-ns device exclusion)"
    impl: "deploy/kubernetes/admission-policy.yaml"
  }
}

# ── KUBERNETES SCHEDULER (external) ───────────────────────────────────────────

Kubernetes Scheduler: {
  direction: down
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  label: "◈ Kubernetes Scheduler (built-in DRA)"

  Structured Parameters: {
    shape: sql_table
    role: "allocates CXI device from ResourceSlices"
    feature_gate: "DRADeviceBindingConditions=true"
    binding_gate: "waits for Ready=True before binding pod"
    on_unschedulable: "deallocates + retries on another device"
  }
}

# ── DRA NODE DRIVER (DaemonSet, all implemented) ───────────────────────────────

DRA Node Driver: {
  direction: down
  style.fill: "#e3f2fd"
  label: "■ DRA Node Driver (DaemonSet)"

  Kubelet Plugin: {
    shape: sql_table
    label: "■ Kubelet Plugin"
    impl: "internal/driver/driver.go"
    role: "device discovery + slice publishing + run loop"
    discovers: "sysfs (real) / mockDevices (--mock-devices)"
    resolves: "CXI ↔ HSN via PCIe root"
    publishes: "node-scoped ResourceSlice per device"
    avail_refresh: "ticker (--resource-refresh-interval) + event-driven via notify chan"
    ticker_action: "reconcileOccupancyFromHardware THEN publish()"
  }

  ClaimBinder: {
    shape: sql_table
    label: "■ ClaimBinder (BindingConditions)"
    impl: "internal/driver/claimbinder.go"
    role: "live fit-check + per-ns device occupancy gate; gates pod binding"
    watches: "ResourceClaims cluster-wide"
    Ready_True: "fits effective avail AND (ns,dev) not occupied; pending + occupancy recorded under one lock"
    Ready_False: "fits hardware but pending blocks; periodic retry"
    Unschedulable_DeviceAtCapacity: "hardware truly full on this device"
    Unschedulable_NamespaceDeviceOccupied: "another claim in same ns already on this device (SHS14 -EEXIST guard; rare with CEL pre-filter in place)"
    cleanup_on_dealloc: "Allocation=nil → RemovePending + RemoveOccupancyForClaim"
    cleanup_on_delete: "watch.Deleted → RemovePending + RemoveOccupancyForClaim"
  }

  Polling Reconciler: {
    shape: sql_table
    label: "■ Polling Reconciler"
    impl: "internal/driver/reconciler.go"
    role: "reconciles in-memory occupancy with live CXI services"
    cadence: "once per ticker, BEFORE publish()"
    skip_mock: "mockDevices != nil → no-op (no hardware to enumerate)"
    list_vnis: "cxi.ReadActiveServiceVNIs(dev) → live service VNIs per device"
    list_ns: "client-go Namespaces().List() → vni → namespace map"
    keep_rule: "entry KEPT if UID in pending OR (ns,dev) in hwSet"
    release_rule: "entry RELEASED via removeOccupancyLocked otherwise"
    adopt_rule: "hwSet-only entry ADDED with synthetic UID hw:<dev>/<ns>"
    self_cleaning: "synthetic entry released on next reconcile after service goes away"
    covers: "driver restart, missed watch events, force-deleted pods, NRI short-circuits"
  }

  PrepareResourceClaims: {
    shape: sql_table
    label: "■ PrepareResourceClaims"
    impl: "internal/driver/prepare.go"
    role: "kubelet plugin hook"
    resolves_resources: "from claim opaque config (8 required fields)"
    ceiling_check: "fast-fail if request > hardware total - overhead"
    reads_vni: "from claim.namespace annotation (10-retry)"
    writes_store: "podUID → []PodAllocation{Device,HSN,VNI}"
    returns_cdi: "[]CDI device IDs"
  }

  UnprepareResourceClaims: {
    shape: sql_table
    label: "■ UnprepareResourceClaims"
    impl: "internal/driver/unprepare.go"
    role: "kubelet plugin hook"
    clears: "AllocationStore.Delete(podUID) only"
    no_occupancy_touch: "does NOT release occupancy — racing the kernel service would cause -EEXIST on the next grant; NRI + binder + reconciler own occupancy release"
  }

  AllocationStore: {
    shape: sql_table
    label: "■ AllocationStore"
    impl: "internal/driver/store.go"
    role: "podUID → device assignment (NRI reads)"
    fields: "DeviceName, DevPath, HSNIface, VNI, Resources"
  }

  NRI Plugin: {
    shape: sql_table
    label: "■ NRI Plugin"
    impl: "internal/nri/plugin.go"
    RunPodSandbox: "per-device mutex; secondary fit-check; CreateService(dev, netnsInode, VNI, ResourceSet); RemovePending on success"
    CreateContainer: "inject SLINGSHOT_DEVICES, SLINGSHOT_VNIS, SLINGSHOT_SVC_IDS (env-spec integration gated by --enable-cdi-env)"
    StopPodSandbox: "DestroyService; RemoveOccupancy per (ns,dev) (idempotent, even on DeleteService error); TriggerRetry; TriggerRepublish"
  }

  Namespace VNI Allocator: {
    shape: sql_table
    label: "■ Namespace VNI Allocator (leader-elected)"
    impl: "internal/driver/vniallocator.go + vnipool.go"
    lease: "cxi-vni-allocator-leader (15s/10s/2s)"
    informer: "namespaces; single workqueue worker"
    skip_list: "kube-system, kube-public, kube-node-lease"
    annotates: "cxi.slingshot.hpe.com/vni = <int>"
    respects_preset: "leaves valid pre-existing annotations alone"
    on_exhaustion: "logs error; key requeued"
  }

  Occupancy Tables: {
    shape: sql_table
    label: "■ pending + nsDeviceOccupancy + claimToOccupancy"
    impl: "internal/driver/driver.go (under pendingMu)"
    role: "in-flight grants + per-(ns,dev) slot tracking"
    pending: "map[claimUID]pendingEntry{ns, dev, resources} — bridges Ready=True grant to service creation"
    nsDeviceOccupancy: "map[ns]map[dev]claimUID — UID-valued so binder can release by UID without knowing device"
    claimToOccupancy: "map[claimUID]occupancyKey{ns, dev} — reverse index for the binder cleanup path"
    add: "checkAndAddPending under mutex (4-way: granted / occupied / hwFull / Ready=False)"
    remove_pending: "RemovePending after NRI CreateService succeeds; also called by binder cleanup paths"
    remove_occupancy_by_pair: "RemoveOccupancy(ns,dev) — NRI StopPodSandbox path"
    remove_occupancy_by_uid: "RemoveOccupancyForClaim(uid) — binder cleanup path (Allocation=nil / claim deleted)"
    centralised_release: "all releases go through removeOccupancyLocked; forward + reverse maps stay strictly in lockstep"
    used_by: "effectiveAvail() to subtract from published avail_*; active_namespaces attribute build"
  }

  ResourceSlice CXI: {
    shape: sql_table
    label: "■ ResourceSlice (CXI devices)"
    impl: "internal/driver/resourceslice.go"
    pool: "<nodeName> (node-scoped)"
    devices: "cxi0..cxi3"
    attrs: "numa.node, pcie.root, hsn"
    capacity: "8 ResourceSet fields per device"
    avail: "live: hwAvail − pending"
    active_namespaces: "comma-padded sorted string ',ns1,ns2,' per device; drives CEL exclusion selector"
    multi_alloc: "AllowMultipleAllocations=true"
  }

  Kubelet Plugin -> ResourceSlice CXI: "publishes + refreshes"
  ClaimBinder -> Kubelet Plugin: "TriggerRepublish on grant"
  ClaimBinder -> Occupancy Tables: "checkAndAddPending (records pending + occupancy under one lock)"
  ClaimBinder -> Occupancy Tables: "RemovePending + RemoveOccupancyForClaim on Allocation=nil / claim deleted"
  Polling Reconciler -> Occupancy Tables: "applyReconcile (release leaks, adopt orphans with synthetic UID)"
  Polling Reconciler -> Kubelet Plugin: "TriggerRepublish on state change"
  Kubelet Plugin -> PrepareResourceClaims: "kubelet calls on pod scheduled"
  PrepareResourceClaims -> UnprepareResourceClaims: "kubelet calls on pod removal"
  PrepareResourceClaims -> AllocationStore: "write podUID → allocation"
  AllocationStore -> NRI Plugin: "NRI reads on RunPodSandbox / StopPodSandbox"
  NRI Plugin -> Occupancy Tables: "RemovePending after service create"
  NRI Plugin -> Occupancy Tables: "RemoveOccupancy(ns,dev) after DestroyService"
  NRI Plugin -> ClaimBinder: "TriggerRetry on StopPodSandbox"
}

# ── NODE RESOURCES ────────────────────────────────────────────────────────────

Node Resources: {
  direction: down
  style.fill: "#e8f5e9"
  label: "■ Node Resources"

  Namespace: {
    shape: sql_table
    label: "◈ Namespace (cluster object)"
    annotation: "cxi.slingshot.hpe.com/vni"
    scope: "one VNI per namespace; shared by all pods in it"
    tenancy: "namespace == cluster allocation"
  }

  CXI Device: {
    shape: sql_table
    label: "■ CXI Device"
    impl: "internal/cxi/device.go"
    path: "/dev/cxi0..3"
    sysfs: "/sys/class/cxi_user/cxi0/..."
    capacity: "device-level total (read at startup)"
  }

  HSN Interface: {
    shape: sql_table
    label: "■ HSN Interface"
    impl: "internal/cxi/hsn.go"
    path: "/sys/class/net/hsn0..3"
    discovery: "matched to CXI via PCIe root"
  }

  CXI Service: {
    shape: sql_table
    label: "■ CXI Service"
    impl: "service_cgo.go (real) / service_mock.go (mock)"
    binding: "netns inode + VNI + ResourceSet"
    libcxi: "alloc via libcxi ioctl (-tags cxi build)"
    pool_sizes: "TLEPoolSize=512, LEPoolSize=1024"
    list_api: "cxil_get_svc_list + cxil_svc_get_vni_range → reconciler input"
  }

  ResourceSet: {
    shape: sql_table
    label: "■ ResourceSet (8 fields)"
    impl: "internal/cxi/resources.go"
    fields: "TXQs, TGQs, EQs, CTs, PTEs, ACs, LEs, TLEs"
    ops: "Add(), Sub(), Fits(), ClampToZero()"
  }

  CXI Device -> HSN Interface: "paired via PCIe topology"
  CXI Device -> CXI Service: "service created against device"
}

# ── CDI + CONTAINER ───────────────────────────────────────────────────────────

Container: {
  direction: down
  style.fill: "#fce4ec"
  label: "■ Container"

  CDI Spec: {
    shape: sql_table
    label: "■ CDI Spec (device node)"
    impl: "internal/cdi/spec.go"
    contents: "DeviceNodes /dev/cxiN (Mode/UID/GID)"
    written_at: "driver startup, per discovered device"
    consumed_by: "containerd via cdi_spec_dirs"
    no_privileged: "lets non-root pods access /dev/cxiN"
  }

  CDI Env Spec: {
    shape: sql_table
    label: "■ CDI Env Spec"
    impl: "internal/cdi/env.go + internal/cdi/containerd.go"
    flag: "--enable-cdi-env=true (set in daemonset)"
    purpose: "injects libfabric/libcxi libs + optional NCCL/AWS-OFI-NCCL"
    opt_in: "per-claim cdi_profiles: [env, nccl, aws-ofi-nccl]"
    auto_configure: "writes /etc/containerd/conf.d/50-cxi-cdi.toml + SIGHUPs containerd at startup"
  }

  Pod Container: {
    shape: sql_table
    label: "■ Pod Container"
    devices: "/dev/cxiN via CDI DeviceNodes"
    no_privileged_required: "CDI grants device access without privileged"
    vni_scope: "restricted by CXI service to namespace VNI"
    libfabric: "discovers HSN via sysfs"
  }

  CDI Spec -> Pod Container: "kubelet applies on container start"
}

# ── FLOWS ────────────────────────────────────────────────────────────────────

# Admission
Workload.Pods.POD -> Admission.Policy: "ResourceClaim CREATE intercepted"
Admission.Policy -> Workload.Pods.POD: "claim with opaque config + 2 CEL selectors persisted"

# Scheduling (slice flows into scheduler; selectors filter eligible devices)
Workload.Pods.POD -> Kubernetes Scheduler.Structured Parameters: "pending pod"
DRA Node Driver.ResourceSlice CXI -> Kubernetes Scheduler.Structured Parameters: "available CXI capacity + active_namespaces"

# Binding gate
Kubernetes Scheduler.Structured Parameters -> DRA Node Driver.ClaimBinder: "claim allocated to this node"
DRA Node Driver.ClaimBinder -> Kubernetes Scheduler.Structured Parameters: "Ready=True (bind) / Unschedulable: DeviceAtCapacity | NamespaceDeviceOccupied (retry)"

# Namespace VNI
DRA Node Driver.Namespace VNI Allocator -> Node Resources.Namespace: "patch annotation"
Node Resources.Namespace -> DRA Node Driver.PrepareResourceClaims: "read VNI annotation"
Node Resources.Namespace -> DRA Node Driver.Polling Reconciler: "list namespaces → vni → ns map"

# Node preparation
Kubernetes Scheduler.Structured Parameters -> DRA Node Driver.PrepareResourceClaims: "pod scheduled to node"
DRA Node Driver.PrepareResourceClaims -> Container.CDI Spec: "returns CDI device IDs"

# Container lifecycle (NRI → service)
DRA Node Driver.NRI Plugin -> Node Resources.CXI Service: "CreateService(dev, netnsInode, VNI)"
Node Resources.CXI Service -> Container.Pod Container: "scopes access to (netns, VNI)"
Node Resources.CXI Service -> DRA Node Driver.Polling Reconciler: "cxil_get_svc_list → live VNIs"

# Hardware discovery
DRA Node Driver.Kubelet Plugin -> Node Resources.CXI Device: "discovers at startup"
Node Resources.CXI Device -> Container.Pod Container: "/dev/cxiN via CDI"
