direction: down

# Legend
legend: {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#9e9e9e"
  label: "■ Implemented  □ Not yet implemented  ◈ External (k8s/user)"
}

# ── USER / WORKLOAD (external) ─────────────────────────────────────────────────

Workload: {
  direction: down
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  label: "◈ Workload (user-created)"

  Owning Resource: {
    shape: sql_table
    kind: "Deployment / ReplicaSet / StatefulSet / Job"
  }

  Device Claim Template: {
    shape: sql_table
    type: "ResourceClaimTemplate"
    deviceClassName: "cxi-device"
    shape_examples: "cxi-small / cxi-medium / cxi-large / cxi-whole"
    requests: "capacity.requests: txqs … les, tles"
    per_pod: "ephemeral claim per pod (one CXI, no VNI claim)"
  }

  Pods: {
    direction: right
    style.fill: "#bdbdbd"
    POD: {
      shape: sql_table
      status: "pending → bound → running"
      resourceClaims: "single CXI device template"
    }
  }

  Owning Resource -> Pods.POD: "creates (many)"
  Owning Resource -> Device Claim Template: "references"
}

# ── MUTATING ADMISSION POLICY (implemented; declarative CEL) ───────────────────

Admission: {
  direction: down
  style.fill: "#fff3e0"
  label: "■ MutatingAdmissionPolicy (CEL)"

  Policy: {
    shape: sql_table
    label: "■ admission-policy.yaml"
    role: "converts legacy opaque CXI config into capacity.requests"
    triggers_on: "ResourceClaim CREATE (requests[0] without capacity, config[0] CXI opaque)"
    failure_policy: "Ignore (claim passes through)"
    constants: "le_pools × 1024 → les, tle_pools × 512 → tles"
    impl: "deploy/kubernetes/admission-policy.yaml"
  }
}

# ── KUBERNETES SCHEDULER (external) ───────────────────────────────────────────

Kubernetes Scheduler: {
  direction: down
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  label: "◈ Kubernetes Scheduler (built-in DRA)"

  Structured Parameters: {
    shape: sql_table
    role: "allocates CXI device from ResourceSlices"
    feature_gate: "DRAConsumableCapacity + DRADeviceBindingConditions"
    accounting: "Σ consumedCapacity per device ≤ capacity value (primary capacity gate)"
    records: "consumedCapacity (policy-rounded) + shareID per allocation"
    binding_gate: "waits for Ready=True before binding pod"
    on_unschedulable: "deallocates + retries on another device"
  }
}

# ── DRA NODE DRIVER (DaemonSet, all implemented) ───────────────────────────────

DRA Node Driver: {
  direction: down
  style.fill: "#e3f2fd"
  label: "■ DRA Node Driver (DaemonSet)"

  Kubelet Plugin: {
    shape: sql_table
    label: "■ Kubelet Plugin"
    impl: "internal/driver/driver.go"
    role: "device discovery + slice publishing + run loop"
    discovers: "sysfs (real) / mockDevices (--mock-devices)"
    resolves: "CXI ↔ HSN via PCIe root"
    std_attrs: "resource.kubernetes.io/numaNode + pciBusID (standard cross-driver attrs for NIC↔GPU matchAttribute)"
    publishes: "node-scoped ResourceSlice, once at startup (static)"
    ticker_action: "reapOrphanServices (--resource-refresh-interval)"
  }

  ClaimBinder: {
    shape: sql_table
    label: "■ ClaimBinder (BindingConditions)"
    impl: "internal/driver/claimbinder.go"
    role: "safety-net fit-check against live hardware; gates pod binding"
    covers: "out-of-band services; pre-upgrade claims with no consumedCapacity"
    requested: "allocation consumedCapacity"
    watches: "ResourceClaims cluster-wide"
    Ready_True: "fits effective avail (hwAvail − pending); pending recorded under pendingMu"
    Ready_False: "fits hardware but pending blocks; periodic retry"
    Unschedulable_DeviceAtCapacity: "hardware truly full on this device"
    cleanup_on_dealloc: "Allocation=nil → RemovePending"
    cleanup_on_delete: "watch.Deleted → RemovePending"
  }

  Orphan Reaper: {
    shape: sql_table
    label: "■ Orphan-service Reaper"
    impl: "internal/driver/reaper.go"
    role: "destroys CXI services whose owning pod is gone"
    cadence: "once per ticker"
    skip_mock: "mockDevices != nil → no-op (no hardware to enumerate)"
    list_svcs: "cxi.ReadActiveServices(dev) → live services per device"
    preserve_rule: "kept if blessed / is_system_svc / owned by live pod (LiveSvcIDs) / netns still live / netns indeterminate"
    grace: "deleted only after N consecutive orphan cycles"
    covers: "driver restart, force-deleted pods, NRI StopPodSandbox short-circuits"
  }

  PrepareResourceClaims: {
    shape: sql_table
    label: "■ PrepareResourceClaims"
    impl: "internal/driver/prepare.go"
    role: "kubelet plugin hook"
    resolves_resources: "from allocation consumedCapacity; opaque config fallback for pre-upgrade claims; rejects opaque config exceeding consumed"
    ceiling_check: "fast-fail if request > hardware total - overhead"
    reads_vni: "from claim.namespace annotation (10-retry)"
    writes_store: "podUID → []PodAllocation{Device,HSN,VNI}"
    writes_cni_hint: "atomic write of <--cni-hints-dir>/<podUID>.json (one {device,hsn_iface,vni} per device) — handoff to slingshot-cni; failure fails the claim"
    returns_cdi: "[]CDI device IDs"
  }

  UnprepareResourceClaims: {
    shape: sql_table
    label: "■ UnprepareResourceClaims"
    impl: "internal/driver/unprepare.go"
    role: "kubelet plugin hook"
    clears: "AllocationStore.Delete(podUID); best-effort delete of the CNI hint file"
    no_occupancy_touch: "does NOT destroy the kernel service — racing it would cause resource churn on the next grant; NRI + reaper own service teardown"
  }

  AllocationStore: {
    shape: sql_table
    label: "■ AllocationStore"
    impl: "internal/driver/store.go"
    role: "podUID → device assignment (NRI reads)"
    fields: "DeviceName, DevPath, HSNIface, VNI, Resources"
  }

  NRI Plugin: {
    shape: sql_table
    label: "■ NRI Plugin"
    impl: "internal/nri/plugin.go"
    RunPodSandbox: "per-device mutex; secondary fit-check; CreateService(dev, netnsInode, VNI, ResourceSet); buildNetSysfs synthetic /sys/class/net; RemovePending on success"
    CreateContainer: "inject SLINGSHOT_DEVICES, SLINGSHOT_VNIS, SLINGSHOT_SVC_IDS; overmount synthetic /sys/class/net (HSN)"
    StopPodSandbox: "DestroyService (idempotent); remove netns sysfs tree; TriggerRetry"
  }

  Namespace VNI Allocator: {
    shape: sql_table
    label: "■ Namespace VNI Allocator (leader-elected)"
    impl: "internal/driver/vniallocator.go + vnipool.go"
    lease: "<driverName>-vni-allocator-leader (15s/10s/2s)"
    informer: "namespaces; single workqueue worker"
    skip_list: "kube-system, kube-public, kube-node-lease"
    annotates: "cxi.slingshot.hpe.com/vni = <int>"
    respects_preset: "leaves valid pre-existing annotations alone"
    on_exhaustion: "logs error; key requeued"
  }

  Pending Grants: {
    shape: sql_table
    label: "■ pending"
    impl: "internal/driver/driver.go (under pendingMu)"
    role: "in-flight grants not yet backed by a service"
    pending: "map[(claimUID,dev)]pendingEntry{dev, resources} — bridges Ready=True grant to service creation"
    add: "checkAndAddPending under mutex (granted / hwFull / Ready=False); idempotent per (claim,dev)"
    remove_pending: "RemovePending after NRI CreateService succeeds; also called by binder cleanup paths (Allocation=nil / claim deleted)"
  }

  ResourceSlice CXI: {
    shape: sql_table
    label: "■ ResourceSlice (CXI devices)"
    impl: "internal/driver/resourceslice.go"
    pool: "<nodeName> (node-scoped)"
    devices: "cxi0..cxi3"
    attrs: "type, hsn_iface, resource.kubernetes.io/{numaNode, pciBusID}"
    capacity: "txqs, tgqs, eqs, cts, ptes, acs, les, tles = usable ceiling (hardware − blessed system services)"
    request_policy: "default per capacity (cxi-small queues, 0 LEs/TLEs); les step 1024, tles step 512"
    impl_capacity: "internal/driver/capacity.go"
    multi_alloc: "AllowMultipleAllocations=true"
    static: "published once; consumption tracked by scheduler, not in the slice"
    std_attrs: "resource.kubernetes.io/numaNode (omitted if unknown) + pciBusID — K8s v1.37 standard device attributes, matchAttribute-comparable with the NVIDIA GPU driver"
  }

  Kubelet Plugin -> ResourceSlice CXI: "publishes once"
  ClaimBinder -> Pending Grants: "checkAndAddPending (records pending under pendingMu)"
  ClaimBinder -> Pending Grants: "RemovePending on Allocation=nil / claim deleted"
  Orphan Reaper -> Node Resources.CXI Service: "DestroyService for orphaned services"
  Kubelet Plugin -> PrepareResourceClaims: "kubelet calls on pod scheduled"
  PrepareResourceClaims -> UnprepareResourceClaims: "kubelet calls on pod removal"
  PrepareResourceClaims -> AllocationStore: "write podUID → allocation"
  AllocationStore -> NRI Plugin: "NRI reads on RunPodSandbox / StopPodSandbox"
  NRI Plugin -> Pending Grants: "RemovePending after service create"
  NRI Plugin -> ClaimBinder: "TriggerRetry on StopPodSandbox"
}

# ── NODE RESOURCES ────────────────────────────────────────────────────────────

Node Resources: {
  direction: down
  style.fill: "#e8f5e9"
  label: "■ Node Resources"

  Namespace: {
    shape: sql_table
    label: "◈ Namespace (cluster object)"
    annotation: "cxi.slingshot.hpe.com/vni"
    scope: "one VNI per namespace; shared by all pods in it"
    tenancy: "namespace == cluster allocation"
  }

  CXI Device: {
    shape: sql_table
    label: "■ CXI Device"
    impl: "internal/cxi/device.go"
    path: "/dev/cxi0..3"
    sysfs: "/sys/class/cxi_user/cxi0/..."
    capacity: "device-level total (read at startup)"
  }

  HSN Interface: {
    shape: sql_table
    label: "■ HSN Interface"
    impl: "internal/cxi/hsn.go"
    path: "/sys/class/net/hsn0..3"
    discovery: "matched to CXI via PCIe root"
  }

  CXI Service: {
    shape: sql_table
    label: "■ CXI Service"
    impl: "service_cgo.go (real) / service_mock.go (mock)"
    binding: "netns inode + VNI + ResourceSet"
    libcxi: "alloc via libcxi ioctl (-tags cxi build)"
    pool_sizes: "TLEPoolSize=512, LEPoolSize=1024"
    list_api: "cxil_get_svc_list → orphan-reaper input"
  }

  ResourceSet: {
    shape: sql_table
    label: "■ ResourceSet (8 fields)"
    impl: "internal/cxi/resources.go"
    fields: "TXQs, TGQs, EQs, CTs, PTEs, ACs, LEs, TLEs"
    ops: "Add(), Sub(), Fits(), ClampToZero()"
  }

  CXI Device -> HSN Interface: "paired via PCIe topology"
  CXI Device -> CXI Service: "service created against device"
}

# ── CDI + CONTAINER ───────────────────────────────────────────────────────────

Container: {
  direction: down
  style.fill: "#fce4ec"
  label: "■ Container"

  CDI Spec: {
    shape: sql_table
    label: "■ CDI Spec (device node)"
    impl: "internal/cdi/spec.go"
    contents: "DeviceNodes /dev/cxiN (Mode/UID/GID)"
    written_at: "driver startup, per discovered device"
    consumed_by: "containerd via cdi_spec_dirs"
    no_privileged: "lets non-root pods access /dev/cxiN"
  }

  CDI Env Spec: {
    shape: sql_table
    label: "■ CDI Env Spec"
    impl: "internal/cdi/env.go + internal/cdi/containerd.go"
    flag: "--enable-cdi-env=true (set in daemonset)"
    purpose: "injects /dev/kdreg2, gdrdrv, xpmem + host libfabric/libcxi (NCCL via k8s-modules)"
    env: "CXIP_SKIP_AMA_CHECK=1 bypasses libfabric AMA gate (no patch, no real netdev)"
    attached: "always, to every CXI device (no per-claim opt-in)"
    auto_configure: "writes /etc/containerd/conf.d/50-cxi-cdi.toml + SIGHUPs containerd at startup"
  }

  Pod Container: {
    shape: sql_table
    label: "■ Pod Container"
    devices: "/dev/cxiN via CDI DeviceNodes"
    no_privileged_required: "CDI grants device access without privileged"
    vni_scope: "restricted by CXI service to namespace VNI"
    libfabric: "stock provider discovers HSN via injected /sys/class/net"
    hsn_ip: "<hsn_iface> (or <hsn_iface>_inet) L2 IPVLAN netdev with Whereabouts address, from slingshot-cni"
  }

  Slingshot CNI: {
    shape: sql_table
    label: "■ slingshot-cni (host CNI plugin, separate process)"
    impl: "cmd/slingshot-cni + internal/cni"
    invoked_by: "containerd/Multus during RunPodSandbox network setup (before the NRI hook)"
    reads: "<hintsDir>/<K8S_POD_UID>.json (bounded retry)"
    ADD: "per device: L2 IPVLAN on host hsn_iface → pod netns as hsn_iface | hsn_iface_inet → DelegateAdd(ipam.type, CNI_IFNAME=<in-pod name>) → apply addr/routes; unwind all on failure"
    DEL: "per device: DelegateDel under the name ADD used; delete IPVLAN only; missing hint/netns/link = success"
    CHECK: "link exists+ipvlan+up; DelegateCheck"
    seams: "linkManager (network_linux.go / network_other.go), ipamDelegate (ipam.go)"
    complementary: "L3 only — does not replace the NRI synthetic sysfs libfabric depends on"
  }

  CDI Spec -> Pod Container: "kubelet applies on container start"
  Slingshot CNI -> Pod Container: "IPVLAN netdev + IP in pod netns"
}

# ── FLOWS ────────────────────────────────────────────────────────────────────

# Admission (legacy claims only)
Workload.Pods.POD -> Admission.Policy: "ResourceClaim CREATE intercepted"
Admission.Policy -> Workload.Pods.POD: "opaque config converted to capacity.requests"

# Scheduling (scheduler charges capacity.requests against device capacity)
Workload.Pods.POD -> Kubernetes Scheduler.Structured Parameters: "pending pod"
DRA Node Driver.ResourceSlice CXI -> Kubernetes Scheduler.Structured Parameters: "per-device consumable capacity"

# Binding gate
Kubernetes Scheduler.Structured Parameters -> DRA Node Driver.ClaimBinder: "claim allocated to this node"
DRA Node Driver.ClaimBinder -> Kubernetes Scheduler.Structured Parameters: "Ready=True (bind) / Unschedulable: DeviceAtCapacity (retry)"

# Namespace VNI
DRA Node Driver.Namespace VNI Allocator -> Node Resources.Namespace: "patch annotation"
Node Resources.Namespace -> DRA Node Driver.PrepareResourceClaims: "read VNI annotation"

# Node preparation
Kubernetes Scheduler.Structured Parameters -> DRA Node Driver.PrepareResourceClaims: "pod scheduled to node"
DRA Node Driver.PrepareResourceClaims -> Container.CDI Spec: "returns CDI device IDs"
DRA Node Driver.PrepareResourceClaims -> Container.Slingshot CNI: "writes hint file (kubelet orders prepare before RunPodSandbox)"
Node Resources.HSN Interface -> Container.Slingshot CNI: "IPVLAN parent"

# Container lifecycle (NRI → service)
DRA Node Driver.NRI Plugin -> Node Resources.CXI Service: "CreateService(dev, netnsInode, VNI)"
Node Resources.CXI Service -> Container.Pod Container: "scopes access to (netns, VNI)"

# Hardware discovery
DRA Node Driver.Kubelet Plugin -> Node Resources.CXI Device: "discovers at startup"
Node Resources.CXI Device -> Container.Pod Container: "/dev/cxiN via CDI"
